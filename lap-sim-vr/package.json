{
  "name": "lap-sim-vr",
  "version": "0.1.0",
  "description": "WebXR (Meta Quest 3/3S) operating room for a DIY laparoscopic cholecystectomy box trainer: live box-camera feed on a virtual OR monitor, complication overlays, vitals, and an event hook for AI agents.",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c blue,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "start:https": "HTTPS=1 PORT=8443 node server/index.js",
    "cert": "node scripts/cert.mjs",
    "mediamtx": "node scripts/mediamtx.mjs",
    "test:screens": "node tests/screenshots.mjs"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@iwer/devui": "^2.8.0",
    "ajv": "^8.20.0",
    "express": "^5.3.0",
    "iwer": "^2.8.0",
    "selfsigned": "^5.5.0",
    "three": "^0.187.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^10.0.7",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.6"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
